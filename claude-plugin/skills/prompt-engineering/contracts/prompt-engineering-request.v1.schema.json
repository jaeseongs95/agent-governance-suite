{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/skills/prompt-engineering/contracts/prompt-engineering-request.v1.schema.json",
  "title": "PromptEngineeringRequest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "mode",
    "objective",
    "snapshotRef",
    "targets",
    "instructionRefs",
    "evidenceRefs",
    "requirements",
    "environment",
    "baseline"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "create",
        "review",
        "improve",
        "compare"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "snapshotRef": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "instructionRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "sourceRef"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "verifiedRefs",
        "unknowns"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "verifiedRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "baseline": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "digest"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "compare"
          }
        }
      },
      "then": {
        "properties": {
          "baseline": {
            "type": "object"
          }
        }
      }
    }
  ]
}
