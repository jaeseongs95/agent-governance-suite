{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-governance-skills.local/task-contract/contracts/task-contract-request.v1.schema.json",
  "title": "TaskContractRequest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "request", "instructionResolutionRefs", "pathSemantics", "authorizationEvidence", "suppliedFacts", "userDecisions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "taskId": { "type": "string", "minLength": 1 },
    "request": { "type": "string", "minLength": 1 },
    "instructionResolutionRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "pathSemantics": { "enum": ["windows", "posix"] },
    "authorizationEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "effect", "authority", "sourceLocator"],
        "properties": {
          "action": { "type": "string", "minLength": 1 },
          "effect": { "enum": ["allow", "prohibit", "require-approval"] },
          "authority": { "enum": ["system", "developer", "user", "project-instruction"] },
          "sourceLocator": { "type": "string", "minLength": 1 }
        }
      }
    },
    "workspaceProfileRef": { "type": "string", "minLength": 1 },
    "suppliedFacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "locator"],
        "properties": {
          "statement": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 }
        }
      }
    },
    "userDecisions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
