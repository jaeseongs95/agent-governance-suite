{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/validate-collaboration-decision-request.v1.schema.json",
  "title": "ValidateCollaborationDecisionRequest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision"],
  "properties": {
    "decision": { "type": "object" },
    "_sessionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "sessionId"],
      "properties": {
        "host": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "actorKind": { "enum": ["main", "subagent", "unknown"] },
        "observedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "assurance": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
