{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/acknowledge-session-messages-request.v1.schema.json",
  "title": "AcknowledgeSessionMessagesRequest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "messageIds"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "messageIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "_sessionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "sessionId"],
      "properties": {
        "host": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
