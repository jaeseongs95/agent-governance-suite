{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/acknowledge-session-messages-request.v1.schema.json",
  "title": "AcknowledgeSessionMessagesRequest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messageIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "messageIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "_sessionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "sessionId"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "receipts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "messageId",
          "claimReceipt"
        ],
        "properties": {
          "messageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "claimReceipt": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,15}:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        }
      }
    }
  }
}
