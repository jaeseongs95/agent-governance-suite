{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/source-lock.v2.schema.json",
  "title": "SourceLock.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillId", "path", "source", "sourcePath", "version", "versionSource",
        "ref", "updatePolicy", "upstreamChecksum", "integratedChecksum",
        "checksumScope", "downstreamModifications"
      ],
      "properties": {
        "skillId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "path": { "type": "string", "pattern": "^skills/[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "source": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "versionSource": { "enum": ["skill-metadata", "version-file"] },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value", "commit"],
          "properties": {
            "kind": { "enum": ["tag", "commit"] },
            "value": { "type": "string", "minLength": 1 },
            "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
          }
        },
        "updatePolicy": { "enum": ["auto-pr", "notify-only", "internal"] },
        "upstreamChecksum": { "$ref": "#/$defs/sha256" },
        "integratedChecksum": { "$ref": "#/$defs/sha256" },
        "checksumScope": { "type": "string", "minLength": 1 },
        "downstreamModifications": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
