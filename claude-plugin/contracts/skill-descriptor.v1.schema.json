{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/skill-descriptor.v1.schema.json",
  "title": "SkillDescriptor.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "path", "phase", "capabilities", "priority", "selectionCriteria", "preconditions", "requiredArtifacts", "producedArtifacts", "riskGate", "enabled"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "path": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "minLength": 1 },
    "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "uniqueItems": true },
    "priority": { "type": "integer", "minimum": 0 },
    "selectionCriteria": { "type": "array", "items": { "type": "string" } },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "requiredArtifacts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "producedArtifacts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "riskGate": { "enum": ["none", "conditional", "mandatory"] },
    "enabled": { "type": "boolean" }
  }
}
