{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/send-session-message-request.v1.schema.json",
  "title": "SendSessionMessageRequest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetHost", "targetSessionId", "body"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "targetHost": { "type": "string", "minLength": 1, "maxLength": 64 },
    "targetSessionId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "body": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "ttlSeconds": { "type": "integer", "minimum": 30, "maximum": 86400, "default": 3600 },
    "messageId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$" },
    "_sessionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "sessionId"],
      "properties": {
        "host": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
