{
  "contractId": "ags-vm-protected-host-installation/v1",
  "revision": "1",
  "provenance": "synthetic-fixture",
  "operationalQualification": false,
  "paths": {
    "windows": {
      "systemParent": "C:\\ProgramData",
      "vmSubtree": "C:\\ProgramData\\flowmarshal",
      "agsSubtree": "C:\\ProgramData\\agent-governance-suite"
    },
    "linux": {
      "systemParent": "/etc",
      "vmSubtree": "/etc/flowmarshal",
      "agsSubtree": "/etc/agent-governance-suite"
    }
  },
  "baselineAssertions": {
    "systemParentUnchanged": true,
    "installerOwnsSubtree": true,
    "parentDeleteChildDenied": true,
    "subtreeReplacementDenied": true,
    "aclOrModeChangeDenied": true,
    "noReparseOrSymlink": true,
    "stablePathAndHandleIdentity": true,
    "keyAndPinRestricted": true,
    "workerDistinctEffectivePrincipal": true,
    "workerKeyReadDenied": true,
    "workerCoreDbDenied": true,
    "workerIpcAccessDenied": true,
    "inheritedHandleOrFdDenied": true,
    "childPrincipalActuallyObserved": true,
    "callerOverrideDenied": true,
    "coreInvocationBound": true,
    "launcherClosureMeasured": true
  },
  "cases": [
    {
      "id": "windows-protected-subtree",
      "os": "windows",
      "override": {},
      "expected": "CONTRACT_CANDIDATE_FIXTURE",
      "reason": "system parent ACL remains unchanged while existing vendor subtree cannot be replaced"
    },
    {
      "id": "linux-protected-subtree",
      "os": "linux",
      "override": {},
      "expected": "CONTRACT_CANDIDATE_FIXTURE",
      "reason": "root-owned /etc subtrees and distinct worker uid satisfy the synthetic boundary"
    },
    {
      "id": "system-root-acl-mutated",
      "os": "both",
      "override": {
        "systemParentUnchanged": false
      },
      "observationPatch": {
        "path": "/objects/systemRoot/aclChanged",
        "value": true
      },
      "expected": "REJECT",
      "reason": "qualification must not change the operating system root ACL or mode"
    },
    {
      "id": "windows-parent-delete-child",
      "os": "windows",
      "override": {
        "parentDeleteChildDenied": false
      },
      "observationPatch": {
        "path": "/objects/systemParent/workerEffective/deleteChild",
        "value": true
      },
      "expected": "REJECT",
      "reason": "effective parent FILE_DELETE_CHILD permits subtree replacement"
    },
    {
      "id": "windows-subtree-delete",
      "os": "windows",
      "override": {
        "subtreeReplacementDenied": false
      },
      "observationPatch": {
        "path": "/objects/subtree/workerEffective/delete",
        "value": true
      },
      "expected": "REJECT",
      "reason": "protected subtree DELETE or rename permits replacement"
    },
    {
