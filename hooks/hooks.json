{
  "description": "Local task continuity binding, compact/resume restore metadata and the session board.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/session-message-hook.mjs\" --host-pid \"$PPID\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\session-message-hook.mjs\" --host-pid (Get-CimInstance Win32_Process -Filter \"ProcessId=$PID\").ParentProcessId",
            "timeout": 10,
            "additionalContextLimit": 8192,
            "statusMessage": "Checking peer messages"
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/continuity-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\continuity-hook.mjs\"",
            "timeout": 10,
            "additionalContextLimit": 1800,
            "statusMessage": "Checking local task continuity"
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/session-board-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\session-board-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/session-message-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\session-message-hook.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/session-message-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\session-message-hook.mjs\"",
            "timeout": 10,
            "additionalContextLimit": 8192
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/session-board-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\session-board-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/continuity-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\continuity-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/continuity-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\continuity-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__agent[-_]governance[-_]suite__(resolve_model_assignment|record_model_application)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/model-routing-host-hook.mjs\" --host codex",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\model-routing-host-hook.mjs\" --host codex",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^mcp__agent[-_]governance[-_]suite__(send_session_message|acknowledge_session_messages|get_session_message_status|get_session_contact_state|contact_session|register_session_task_request|record_session_task_outcome|reconcile_session_task_request|validate_collaboration_decision)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/session-message-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\session-message-hook.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__agent[-_]governance[-_]suite__(open_convergence_root|checkpoint_context|inspect_context|load_context|suppress_context_restore|purge_direct_context)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/continuity-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\continuity-hook.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__agent[-_]governance[-_]suite__(update_session_status|list_session_status)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/session-board-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\session-board-hook.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(shell|local_shell|exec_command|apply_patch|Bash|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/session-board-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\session-board-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__agent[-_]governance[-_]suite__record_model_application$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/model-routing-host-hook.mjs\" --host codex",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\model-routing-host-hook.mjs\" --host codex",
            "timeout": 5,
            "additionalContextLimit": 1200
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/session-message-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\session-message-hook.mjs\"",
            "timeout": 10,
            "additionalContextLimit": 8192
          }
        ]
      }
    ]
  }
}
