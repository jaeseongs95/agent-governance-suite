{
  "description": "Local task continuity binding, compact/resume restore metadata and the session board.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/session-message-hook.mjs\" --host-pid \"$PPID\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\session-message-hook.mjs\" --host-pid (Get-CimInstance Win32_Process -Filter \"ProcessId=$PID\").ParentProcessId",
            "timeout": 10,
            "additionalContextLimit": 8192,
            "statusMessage": "Checking peer messages"
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/continuity-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\continuity-hook.mjs\"",
            "timeout": 10,
            "additionalContextLimit": 1800,
            "statusMessage": "Checking local task continuity"
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/session-board-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\session-board-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/session-message-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\session-message-hook.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/session-message-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\session-message-hook.mjs\"",
            "timeout": 10,
            "additionalContextLimit": 8192
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/session-board-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\session-board-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/continuity-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\continuity-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/continuity-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\continuity-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__agent[-_]governance[-_]suite__.+$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/governance-hook.mjs\" --host=codex",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\governance-hook.mjs\" --host=codex",
            "timeout": 10,
            "statusMessage": "Checking governance call identity"
          }
        ]
      },
      {
        "matcher": "^mcp__codex_app__wait_threads$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/session-message-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\session-message-hook.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(shell|local_shell|exec_command|apply_patch|Bash|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/session-board-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\session-board-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/mcp-server/dist/session-message-hook.mjs\" --host-pid \"$PPID\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\mcp-server\\dist\\session-message-hook.mjs\" --host-pid (Get-CimInstance Win32_Process -Filter \"ProcessId=$PID\").ParentProcessId",
            "timeout": 10,
            "additionalContextLimit": 8192
          }
        ]
      }
    ]
  }
}
