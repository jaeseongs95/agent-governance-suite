{
  "mcpServers": {
    "agent-governance-suite": {
      "command": "node",
      "args": [
        "mcp-server/dist/server.mjs"
      ],
      "cwd": ".",
      "env": {
        "AGENT_GOVERNANCE_HOST_ATTESTATION": "codex"
      },
      "env_vars": [
        "AGENT_GOVERNANCE_ADMIN_PORT",
        "AGENT_GOVERNANCE_ANTIGRAVITY_QUEUE_WAKE",
        "AGENT_GOVERNANCE_CLASSIFICATION_CONFIG",
        "AGENT_GOVERNANCE_CODEX_QUEUE_WAKE",
        "AGENT_GOVERNANCE_CONTEXT_LAYER_DB_PATH",
        "AGENT_GOVERNANCE_CONTINUITY_DB_PATH",
        "AGENT_GOVERNANCE_DB_PATH",
        "AGENT_GOVERNANCE_LOCALE",
        "AGENT_GOVERNANCE_PHASE_EXEMPT_PATHS",
        "AGENT_GOVERNANCE_SESSION_BOARD_DB_PATH",
        "AGENT_GOVERNANCE_SESSION_MESSAGE_STATE_DIR",
        "AGENT_GOVERNANCE_SHARED_STATE_DIR",
        "AGENT_GOVERNANCE_TRUST_DB_PATH",
        "LOCALAPPDATA",
        "XDG_STATE_HOME"
      ]
    }
  }
}
