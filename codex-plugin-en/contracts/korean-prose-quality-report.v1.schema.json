{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/korean-prose-quality-report.v1.schema.json",
  "title": "KoreanProseQualityReport.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "frameId",
    "frameDigest",
    "rubricDigest",
    "adjudicatorActorId",
    "adjudicationInputLocator",
    "adjudicationInputDigest",
    "adjudicationMetaLocator",
    "adjudicationMetaDigest",
    "adjudicationLocator",
    "adjudicationDigest",
    "runCount",
    "runs",
    "reportDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "frameId": { "type": "string", "minLength": 1 },
    "frameDigest": { "$ref": "#/$defs/digest" },
    "rubricDigest": { "$ref": "#/$defs/digest" },
    "adjudicatorActorId": { "type": "string", "format": "uuid" },
    "adjudicationInputLocator": { "type": "string", "minLength": 1 },
    "adjudicationInputDigest": { "$ref": "#/$defs/digest" },
    "adjudicationMetaLocator": { "type": "string", "minLength": 1 },
    "adjudicationMetaDigest": { "$ref": "#/$defs/digest" },
    "adjudicationLocator": { "type": "string", "minLength": 1 },
    "adjudicationDigest": { "$ref": "#/$defs/digest" },
    "runCount": { "type": "integer", "minimum": 1 },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run", "receiptLocator", "receiptDigest", "claimDigest", "actorIds", "caseCount", "complete"],
        "properties": {
          "run": { "type": "integer", "minimum": 1 },
          "receiptLocator": { "type": "string", "minLength": 1 },
          "receiptDigest": { "$ref": "#/$defs/digest" },
          "claimDigest": { "$ref": "#/$defs/digest" },
          "actorIds": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "type": "string", "format": "uuid" }
          },
          "caseCount": { "type": "integer", "minimum": 1 },
          "complete": { "const": true }
        }
      }
    },
    "reportDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
