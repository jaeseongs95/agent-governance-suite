{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/cs-candidate.v1.schema.json",
  "title": "cs-candidate.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scopeSummary",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "scopeSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "digest"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1,
      "maxItems": 10000
    }
  }
}
