{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-governance-skills.local/instruction-scope-resolver/contracts/instruction-scope-resolution.v1.schema.json",
  "title": "InstructionScopeResolution.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspaceRoot", "instructionFileManifest", "targets", "findings", "analysisStatus", "verdict"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "workspaceRoot": { "type": "string", "minLength": 1 },
    "instructionFileManifest": {
      "type": "array",
      "items": { "$ref": "#/$defs/instructionFile" }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestedPath", "resolvedPath", "exists", "instructionChain", "activeRules", "overriddenRules", "unresolvedConflicts"],
        "properties": {
          "requestedPath": { "type": "string", "minLength": 1 },
          "resolvedPath": { "type": "string", "minLength": 1 },
          "exists": { "type": "boolean" },
          "instructionChain": { "type": "array", "items": { "$ref": "#/$defs/instructionFile" } },
          "activeRules": { "type": "array", "items": { "$ref": "#/$defs/activeRule" } },
          "overriddenRules": { "type": "array", "items": { "$ref": "#/$defs/overriddenRule" } },
          "unresolvedConflicts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "analysisStatus": { "enum": ["required", "complete"] },
    "verdict": { "enum": ["ANALYSIS_REQUIRED", "PASS", "NEEDS_INPUT", "BLOCKED"] }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "ANALYSIS_REQUIRED" } }, "required": ["verdict"] },
      "then": { "properties": { "analysisStatus": { "const": "required" } } },
      "else": { "properties": { "analysisStatus": { "const": "complete" } } }
    }
  ],
  "$defs": {
    "instructionFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "replacesSiblingAgents", "size", "sha256", "precedence"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["agents", "override"] },
        "replacesSiblingAgents": { "type": "boolean" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "precedence": { "type": "integer", "minimum": 1 }
      }
    },
    "activeRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "summary", "sourcePath", "sourceLocator"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "sourceLocator": { "type": "string", "minLength": 1 }
      }
    },
    "overriddenRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "broaderSource", "narrowerSource", "reason"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "broaderSource": { "type": "string", "minLength": 1 },
        "narrowerSource": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
