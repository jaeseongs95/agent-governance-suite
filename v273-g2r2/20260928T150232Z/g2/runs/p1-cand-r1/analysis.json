    "old_string": "function fib(n) {\n  if (n < 2) return n;\n  return fib(n - 1) + fib(n - 2);\n}",
    "new_string": "const memo = new Map();\n\nfunction fib(n) {\n  if (n < 2) return n;\n  if (memo.has(n)) return memo.get(n);\n  const result = fib(n - 1) + fib(n - 2);\n  memo.set(n, result);\n  return result;\n}",
    "replace_all": false
   }
  }
