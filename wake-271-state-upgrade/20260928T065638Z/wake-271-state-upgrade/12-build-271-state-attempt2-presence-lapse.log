{"step":"3.schema","user_version":0,"journal_mode":"wal","objects":[{"type":"index","name":"messages_target_pending","tbl_name":"messages","sql":"CREATE INDEX messages_target_pending\n      ON messages (target_host, target_session_id, acknowledged_at, expires_at, claim_until)"},{"type":"index","name":"prepared_messages_expiry","tbl_name":"prepared_messages","sql":"CREATE INDEX prepared_messages_expiry ON prepared_messages (expires_at)"},{"type":"index","name":"prepared_messages_owner","tbl_name":"prepared_messages","sql":"CREATE INDEX prepared_messages_owner ON prepared_messages (sender_host, sender_session_id, receipt)"},{"type":"index","name":"session_presence_latest","tbl_name":"session_presence","sql":"CREATE INDEX session_presence_latest\n      ON session_presence (host, session_id, started_at DESC)"},{"type":"index","name":"wake_active_target","tbl_name":"wake_nonces","sql":"CREATE UNIQUE INDEX wake_active_target ON wake_nonces (host, session_id)\n        WHERE state IN ('reserved', 'started', 'submitted', 'unknown')"},{"type":"table","name":"input_observations","tbl_name":"input_observations","sql":"CREATE TABLE input_observations (\n        host TEXT NOT NULL,\n        session_id TEXT NOT NULL,\n        deferred_tool_claim INTEGER NOT NULL DEFAULT 0 CHECK (deferred_tool_claim IN (0, 1)),\n        observed_at TEXT NOT NULL,\n        PRIMARY KEY (host, session_id)\n      ) STRICT"},{"type":"table","name":"messages","tbl_name":"messages","sql":"CREATE TABLE messages (\n      message_id TEXT PRIMARY KEY,\n      sender_host TEXT NOT NULL,\n      sender_session_id TEXT NOT NULL,\n      target_host TEXT NOT NULL,\n      target_session_id TEXT NOT NULL,\n      body TEXT NOT NULL,\n      body_bytes INTEGER NOT NULL,\n      created_at TEXT NOT NULL,\n      expires_at TEXT NOT NULL,\n      claimed_at TEXT,\n      claim_until TEXT,\n      delivery_attempts INTEGER NOT NULL DEFAULT 0,\n      first_delivered_at TEXT,\n      acknowledged_at TEXT\n    ) STRICT"},{"type":"table","name":"prepared_messages","tbl_name":"prepared_messages","sql":"CREATE TABLE prepared_messages (\n        message_id TEXT PRIMARY KEY,\n        sender_host TEXT NOT NULL,\n        sender_session_id TEXT NOT NULL,\n        target_host TEXT NOT NULL,\n        target_session_id TEXT NOT NULL,\n        body TEXT,\n        ttl_seconds INTEGER NOT NULL,\n        prepared_at TEXT NOT NULL,\n        expires_at TEXT NOT NULL,\n        receipt TEXT,\n        record_bytes INTEGER NOT NULL\n      ) STRICT"},{"type":"table","name":"relay_leases","tbl_name":"relay_leases","sql":"CREATE TABLE relay_leases (\n      host TEXT NOT NULL,\n      session_id TEXT NOT NULL,\n      transport TEXT NOT NULL,\n      relay_id TEXT NOT NULL,\n      pid INTEGER NOT NULL,\n      parent_pid INTEGER NOT NULL,\n      lease_until TEXT NOT NULL,\n      updated_at TEXT NOT NULL,\n      PRIMARY KEY (host, session_id, transport)\n    ) STRICT"},{"type":"table","name":"session_presence","tbl_name":"session_presence","sql":"CREATE TABLE session_presence (\n      host TEXT NOT NULL,\n      session_id TEXT NOT NULL,\n      instance_id TEXT NOT NULL,\n      transport TEXT NOT NULL,\n      wake_visibility TEXT NOT NULL CHECK (wake_visibility IN ('silent', 'user-message', 'none')),\n      can_wake_silently INTEGER NOT NULL CHECK (can_wake_silently IN (0, 1)),\n      supported_injection TEXT NOT NULL DEFAULT '[]',\n      idle_wake TEXT NOT NULL DEFAULT 'none' CHECK (idle_wake IN ('silent', 'user-message', 'none')),\n      collaboration_id TEXT,\n      workspace_id TEXT,\n      role TEXT,\n      started_at TEXT NOT NULL,\n      heartbeat_at TEXT NOT NULL,\n      lease_until TEXT NOT NULL,\n      ended_at TEXT,\n      end_reason TEXT,\n      PRIMARY KEY (host, session_id, instance_id)\n    ) STRICT"},{"type":"table","name":"wake_nonces","tbl_name":"wake_nonces","sql":"CREATE TABLE wake_nonces (\n      nonce_digest TEXT PRIMARY KEY,\n      host TEXT NOT NULL,\n      session_id TEXT NOT NULL,\n      expires_at TEXT NOT NULL,\n      consumed_at TEXT\n    , state TEXT NOT NULL DEFAULT 'legacy' CHECK (state IN ('legacy', 'reserved', 'started', 'submitted', 'unknown', 'observed', 'not-submitted')), nonce TEXT, instance_id TEXT, birth_generation TEXT, transport TEXT, relay_id TEXT, attempt_id TEXT, dispatch_epoch INTEGER NOT NULL DEFAULT 0, retry_not_before TEXT, retry_count INTEGER NOT NULL DEFAULT 0, started_at TEXT, outcome_at TEXT, observed_at TEXT, late_observed_at TEXT) STRICT"}],"wake_nonces_columns":[{"cid":0,"name":"nonce_digest","type":"TEXT","notnull":1,"dflt_value":null,"pk":1},{"cid":1,"name":"host","type":"TEXT","notnull":1,"dflt_value":null,"pk":0},{"cid":2,"name":"session_id","type":"TEXT","notnull":1,"dflt_value":null,"pk":0},{"cid":3,"name":"expires_at","type":"TEXT","notnull":1,"dflt_value":null,"pk":0},{"cid":4,"name":"consumed_at","type":"TEXT","notnull":0,"dflt_value":null,"pk":0},{"cid":5,"name":"state","type":"TEXT","notnull":1,"dflt_value":"'legacy'","pk":0},{"cid":6,"name":"nonce","type":"TEXT","notnull":0,"dflt_value":null,"pk":0},{"cid":7,"name":"instance_id","type":"TEXT","notnull":0,"dflt_value":null,"pk":0},{"cid":8,"name":"birth_generation","type":"TEXT","notnull":0,"dflt_value":null,"pk":0},{"cid":9,"name":"transport","type":"TEXT","notnull":0,"dflt_value":null,"pk":0},{"cid":10,"name":"relay_id","type":"TEXT","notnull":0,"dflt_value":null,"pk":0},{"cid":11,"name":"attempt_id","type":"TEXT","notnull":0,"dflt_value":null,"pk":0},{"cid":12,"name":"dispatch_epoch","type":"INTEGER","notnull":1,"dflt_value":"0","pk":0},{"cid":13,"name":"retry_not_before","type":"TEXT","notnull":0,"dflt_value":null,"pk":0},{"cid":14,"name":"retry_count","type":"INTEGER","notnull":1,"dflt_value":"0","pk":0},{"cid":15,"name":"started_at","type":"TEXT","notnull":0,"dflt_value":null,"pk":0},{"cid":16,"name":"outcome_at","type":"TEXT","notnull":0,"dflt_value":null,"pk":0},{"cid":17,"name":"observed_at","type":"TEXT","notnull":0,"dflt_value":null,"pk":0},{"cid":18,"name":