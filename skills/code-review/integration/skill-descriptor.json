{
  "schemaVersion": "2.0.0",
  "skillId": "code-review",
  "version": "0.1.0",
  "path": "./code-review",
  "enabled": true,
  "priority": 68,
  "providers": [
    {
      "capabilities": [
        "change-code-review"
      ],
      "executionClass": "workflow",
      "phase": "change-code-review",
      "phaseOrder": 68,
      "requiredInputArtifacts": [
        "engineering-review-request",
        "engineering-review-report"
      ],
      "inputBindings": [
        {
          "targetArtifact": "engineering-review-request",
          "sources": [
            "task:engineering-review-request"
          ],
          "operation": "require-external"
        },
        {
          "targetArtifact": "engineering-review-report",
          "sources": [
            "task:engineering-review-report"
          ],
          "operation": "require-external"
        }
      ],
      "producedArtifacts": [
        "engineering-review-result"
      ],
      "outputSchema": "contracts/engineering-review-result.v1.schema.json",
      "resultSchema": "contracts/provider-result.v1.schema.json",
      "stateMapping": {
        "selector": "/output/verdict",
        "values": {
          "NO_BLOCKING_FINDINGS": {
            "state": "passed",
            "errorRequired": false
          },
          "CHANGES_REQUESTED": {
            "state": "failed",
            "errorRequired": true,
            "allowedErrorCodes": [
              "GATE_FAILED"
            ]
          },
          "INCOMPLETE": {
            "state": "blocked",
            "errorRequired": true,
            "allowedErrorCodes": [
              "MISSING_EVIDENCE"
            ]
          }
        },
        "default": "reject",
        "adapterErrors": [
          "INVALID_INPUT",
          "MISSING_EVIDENCE",
          "INTEGRITY_FAILED"
        ]
      },
      "selectionCriteria": [
        "explicit-change-code-review",
        "semantically-matching-authorized-work"
      ],
      "preconditions": [
        "The applicable AGS instructions and existing authorization are known.",
        "Input artifacts are fixed by references. Selection metadata is not runtime semantic enforcement."
      ],
      "failureHandling": "Preserve missing evidence and failed checks; no release or independent-audit authority is granted.",
      "gate": {
        "kind": "none",
        "policy": "none",
        "validator": null
      }
    }
  ]
}
