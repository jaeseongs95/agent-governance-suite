{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/cs-policy.v1.schema.json",
  "title": "cs-policy.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "version",
    "mode",
    "allowDraft"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "policyId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "mode": {
      "enum": [
        "observe",
        "enforce"
      ]
    },
    "allowDraft": {
      "type": "boolean"
    }
  }
}
