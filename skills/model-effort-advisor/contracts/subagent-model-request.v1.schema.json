{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-governance.local/subagent-model-request.v1.schema.json",
  "title": "SubagentModelRequest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assignment", "host"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "assignment": { "$ref": "#/$defs/assignment" },
    "preference": { "enum": ["economy", "balanced", "quality"] },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "capabilityReference", "supported"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "provider": { "$ref": "#/$defs/text" },
        "capabilityReference": { "$ref": "#/$defs/text" },
        "supported": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model", "modelClass", "efforts"],
            "properties": {
              "model": { "$ref": "#/$defs/text" },
              "modelClass": {
                "anyOf": [{ "$ref": "https://skill-suite.local/contracts/model-policy.v1.schema.json#/$defs/modelClass" }, { "type": "null" }]
              },
              "efforts": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "https://skill-suite.local/contracts/model-policy.v1.schema.json#/$defs/reasoningEffort" }
              }
            }
          }
        },
        "inherited": { "$ref": "#/$defs/setting" },
        "inheritanceSupported": { "type": "boolean" },
        "inheritOnly": { "type": "boolean" }
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "model": { "$ref": "#/$defs/text" },
        "effort": { "$ref": "https://skill-suite.local/contracts/model-policy.v1.schema.json#/$defs/reasoningEffort" }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort"],
      "properties": {
        "model": { "$ref": "#/$defs/text" },
        "effort": { "$ref": "https://skill-suite.local/contracts/model-policy.v1.schema.json#/$defs/reasoningEffort" }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "difficulty", "riskLevel", "verification", "signals"],
      "properties": {
        "role": { "enum": ["discovery", "general-implementation", "complex-reasoning", "independent-audit"] },
        "difficulty": { "enum": ["routine", "substantial", "complex", "frontier"] },
        "riskLevel": { "enum": ["low", "medium", "high", "critical"] },
        "verification": { "enum": ["direct", "indirect", "limited"] },
        "signals": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      }
    }
  }
}
