{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-governance.local/subagent-model-advice.v1.schema.json",
  "title": "SubagentModelAdvice.v1",
  "description": "Pre-dispatch advice only. No status grants delegation or establishes effective model settings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "authorityEffect", "assignment", "profile", "capabilitySource", "routingOptions", "selectionPlan"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "status": { "enum": ["READY", "INHERIT_UNVERIFIED", "BLOCKED"] },
    "authorityEffect": { "const": "none" },
    "assignment": { "$ref": "https://agent-governance.local/subagent-model-request.v1.schema.json#/$defs/assignment" },
    "profile": { "enum": ["economy", "balanced", "quality"] },
    "capabilitySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "reference"],
      "properties": { "hostId": { "type": "string", "minLength": 1 }, "reference": { "type": "string", "minLength": 1 } }
    },
    "routingOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "role", "profile", "highRisk", "supported"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "role": { "$ref": "https://agent-governance.local/subagent-model-request.v1.schema.json#/$defs/assignment/properties/role" },
        "profile": { "enum": ["economy", "balanced", "quality"] },
        "highRisk": { "type": "boolean" },
        "supported": { "$ref": "https://agent-governance.local/subagent-model-request.v1.schema.json#/properties/host/properties/supported" },
        "inherited": { "$ref": "https://agent-governance.local/subagent-model-request.v1.schema.json#/$defs/setting" },
        "inheritanceSupported": { "type": "boolean" },
        "inheritOnly": { "type": "boolean" },
        "user": { "$ref": "https://agent-governance.local/subagent-model-request.v1.schema.json#/properties/user" }
      }
    },
    "selectionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "selection", "delivery", "fallbackReason"],
      "properties": {
        "requested": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false, "required": ["model", "effort"],
              "properties": {
                "model": { "type": ["string", "null"], "minLength": 1 },
                "effort": { "anyOf": [{ "$ref": "https://skill-suite.local/contracts/model-policy.v1.schema.json#/$defs/reasoningEffort" }, { "type": "null" }] }
              }
            }
          ]
        },
        "selection": { "anyOf": [{ "$ref": "https://agent-governance.local/subagent-model-request.v1.schema.json#/$defs/setting" }, { "type": "null" }] },
        "delivery": { "enum": ["explicit", "inherited", "blocked"] },
        "fallbackReason": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "READY" } } },
      "then": { "properties": { "selectionPlan": { "properties": { "selection": { "type": "object" }, "delivery": { "enum": ["explicit", "inherited"] } } } } }
    },
    {
      "if": { "properties": { "status": { "const": "INHERIT_UNVERIFIED" } } },
      "then": { "properties": { "selectionPlan": { "properties": { "selection": { "type": "null" }, "delivery": { "const": "inherited" } } } } }
    },
    {
      "if": { "properties": { "status": { "const": "BLOCKED" } } },
      "then": { "properties": { "selectionPlan": { "properties": { "selection": { "type": "null" }, "delivery": { "const": "blocked" } } } } }
    }
  ]
}
