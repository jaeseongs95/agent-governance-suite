{
  "schemaVersion": "2.0.0",
  "providers": [{
    "skillId": "codex-token-usage-analyzer",
    "version": "0.1.0",
    "enabled": true,
    "capabilities": ["local-codex-token-usage-analysis"],
    "priority": 50,
    "executionClass": "workflow",
    "phase": "usage-analysis",
    "phaseOrder": 50,
    "requiredInputArtifacts": ["token-usage-report-request"],
    "inputBindings": [
      { "targetArtifact": "token-usage-report-request", "sources": ["workflow:token-usage-report-request"], "operation": "require-external" }
    ],
    "producedArtifacts": ["token-usage-report", "token-usage-markdown-artifact"],
    "outputSchema": "contracts/token-usage-report.v1.schema.json",
    "resultSchema": "integration/provider-result.v1.schema.json",
    "stateMapping": {
      "selector": "/output/verdict",
      "values": {
        "PASS": { "state": "passed", "errorRequired": false },
        "PARTIAL": { "state": "passed", "errorRequired": false },
        "NEEDS_INPUT": { "state": "needs-input", "errorRequired": true, "allowedErrorCodes": ["RUN_NOT_FOUND", "INVALID_INPUT"] },
        "BLOCKED": { "state": "blocked", "errorRequired": true, "allowedErrorCodes": ["MISSING_EVIDENCE"] }
      },
      "default": "reject",
      "adapterErrors": ["INVALID_INPUT", "MISSING_EVIDENCE"]
    },
    "selectionCriteria": ["explicit-codex-token-usage-analysis-request"],
    "preconditions": ["The request explicitly invokes codex-token-usage-analyzer and local Codex session logs are readable."],
    "failureHandling": {
      "missingInput": "needs-input",
      "invalidReport": "failed",
      "retry": "corrected-request-or-access-only"
    },
    "gate": { "kind": "none", "policy": "none" }
  }]
}
