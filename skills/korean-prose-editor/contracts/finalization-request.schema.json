{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/korean-prose-editor/finalization-request.schema.json",
  "title": "Finalization request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "subagentsAvailable", "plan", "source", "manifest", "sourceUnitManifest", "selection", "editing", "verification", "rubricDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "mode": { "enum": ["mcp", "direct"] },
    "subagentsAvailable": { "const": true },
    "plan": { "$ref": "provider-plan.schema.json" },
    "source": { "type": "string" },
    "manifest": { "$ref": "protected-manifest.schema.json" },
    "sourceUnitManifest": { "$ref": "source-unit-manifest.v1.schema.json" },
    "selection": { "$ref": "selection-work-product.v1.schema.json" },
    "editing": { "$ref": "editing-work-product.v1.schema.json" },
    "verification": { "$ref": "verification-work-product.v1.schema.json" },
    "rubricDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
