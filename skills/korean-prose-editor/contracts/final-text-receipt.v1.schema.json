{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/korean-prose-editor/final-text-receipt.v1.schema.json",
  "title": "Raw-text-free final text receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "actorIds", "digest", "length", "glossary", "decisions", "warnings"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "actorIds": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/actorId" }
    },
    "digest": { "type": "object", "additionalProperties": false, "required": ["source", "result", "manifest"], "properties": { "source": { "$ref": "#/$defs/digest" }, "result": { "$ref": "#/$defs/digest" }, "manifest": { "$ref": "#/$defs/digest" } } },
    "length": { "type": "object", "additionalProperties": false, "required": ["source", "result"], "properties": { "source": { "type": "integer", "minimum": 0 }, "result": { "type": "integer", "minimum": 0 } } },
    "glossary": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "status", "id", "version", "contentDigest", "matchSetDigest", "matchCount", "warnings"],
      "properties": {
        "mode": { "enum": ["none", "mcp"] },
        "status": { "enum": ["direct", "matched", "no-match", "unavailable", "limit-exceeded", "unsupported-normalization"] },
        "id": { "oneOf": [{ "const": "korean-prose-core" }, { "type": "null" }] },
        "version": { "oneOf": [{ "const": "1.1.0" }, { "type": "null" }] },
        "contentDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "matchSetDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "matchCount": { "type": "integer", "minimum": 0, "maximum": 256 },
        "warnings": { "type": "array", "uniqueItems": true, "items": { "enum": ["GLOSSARY_UNAVAILABLE", "GLOSSARY_MATCH_LIMIT_EXCEEDED", "GLOSSARY_UNSUPPORTED_NORMALIZATION"] } }
      }
    },
    "decisions": { "type": "object", "additionalProperties": false, "required": ["mode", "assurance", "status", "appliedEditDigests", "retainedEditDigests", "fallback"], "properties": { "mode": { "enum": ["mcp", "direct"] }, "assurance": { "enum": ["verified", "unverified"] }, "status": { "enum": ["finalized", "fallback", "blocked"] }, "appliedEditDigests": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "uniqueItems": true }, "retainedEditDigests": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "uniqueItems": true }, "fallback": { "type": "boolean" } } },
    "warnings": { "type": "array", "items": { "enum": ["EDIT_CONTRACT_INVALID", "EDIT_OUT_OF_SCOPE_RETAINED", "EDIT_RANGES_OVERLAP", "EDITING_DIGEST_MISMATCH", "FINAL_PROTECTED_CHECK_FAILED", "GLOBAL_FALLBACK_APPLIED", "GLOSSARY_BINDING_INVALID", "GLOSSARY_BINDING_MISMATCH", "GLOSSARY_MATCH_SET_INVALID", "GLOSSARY_PROTECT_MISSING", "GLOSSARY_UNAVAILABLE", "GLOSSARY_MATCH_LIMIT_EXCEEDED", "GLOSSARY_UNSUPPORTED_NORMALIZATION", "MANIFEST_SCHEMA_VERSION", "MANIFEST_SPANS_INVALID", "MANIFEST_SPAN_INVALID", "NON_MINIMAL_EDIT_RETAINED", "PROTECTED_EDIT_RETAINED", "PROTECTED_SPAN_MISSING_OR_REORDERED", "SELECTION_CONTRACT_INVALID", "SELECTION_DIGEST_MISMATCH", "SELECTION_NOT_READY", "SOURCE_MANIFEST_MISMATCH", "SOURCE_UNIT_MANIFEST_MISMATCH", "VERIFICATION_CONTRACT_INVALID", "VERIFICATION_DECISION_INVALID", "VERIFICATION_DECISION_MISSING", "VERIFICATION_DIGEST_MISMATCH", "VERIFICATION_RUBRIC_DIGEST_MISMATCH", "VERIFIER_GLOBAL_FALLBACK"] }, "uniqueItems": true }
  },
  "$defs": {
    "actorId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
