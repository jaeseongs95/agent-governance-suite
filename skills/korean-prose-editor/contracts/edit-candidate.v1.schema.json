{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/korean-prose-editor/edit-candidate.v1.schema.json",
  "title": "Edit candidate reference receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "actorId", "digest", "length", "decisions", "warnings"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "actorId": { "$ref": "#/$defs/actorId" },
    "digest": { "type": "object", "additionalProperties": false, "required": ["source", "candidate", "artifact"], "properties": { "source": { "$ref": "#/$defs/digest" }, "candidate": { "$ref": "#/$defs/digest" }, "artifact": { "$ref": "#/$defs/digest" } } },
    "length": { "type": "object", "additionalProperties": false, "required": ["source", "candidate"], "properties": { "source": { "type": "integer", "minimum": 0 }, "candidate": { "type": "integer", "minimum": 0 } } },
    "decisions": { "type": "object", "additionalProperties": false, "required": ["status", "editCount"], "properties": { "status": { "enum": ["ready", "needs-input", "blocked"] }, "editCount": { "type": "integer", "minimum": 0 } } },
    "warnings": { "$ref": "#/$defs/warnings" }
  },
  "$defs": {
    "actorId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "warnings": { "type": "array", "items": { "enum": ["EDITING_UNCERTAIN", "EDITING_BLOCKED", "EDIT_SCOPE_RETAINED", "PROTECTED_CONTEXT_MISSING"] }, "uniqueItems": true }
  }
}
