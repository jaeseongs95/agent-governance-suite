{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-governance-skills.local/instruction-scope-resolver/contracts/instruction-scope-request.v1.schema.json",
  "title": "InstructionScopeRequest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspaceRoot", "instructionRoots", "targets", "externalPolicyRefs"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "workspaceRoot": { "type": "string", "minLength": 1 },
    "instructionRoots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "precedence", "authorized"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "precedence": { "type": "integer", "minimum": 0 },
          "authorized": { "type": "boolean" }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mayNotExist"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "mayNotExist": { "type": "boolean" }
        }
      }
    },
    "externalPolicyRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "locator"],
        "properties": {
          "layer": { "enum": ["system", "developer", "user"] },
          "locator": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
