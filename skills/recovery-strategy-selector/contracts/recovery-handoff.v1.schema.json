{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-governance-skills.local/recovery-strategy-selector/contracts/recovery-handoff.v1.schema.json",
  "title": "RecoveryHandoff.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "handoffId", "selectionRequestDigest", "sourceTask", "sourceWorkflow", "diagnosis", "strategies", "survivingStrategyIds", "crossReview", "selectedStrategyId", "nextTaskSeed", "approvalRequired", "limitations", "verdict"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "handoffId": { "type": "string", "minLength": 1 },
    "selectionRequestDigest": { "$ref": "#/$defs/digest" },
    "sourceTask": { "$ref": "#/$defs/sourceTask" },
    "sourceWorkflow": { "$ref": "#/$defs/sourceWorkflow" },
    "diagnosis": { "$ref": "#/$defs/diagnosis" },
    "strategies": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/$defs/strategy" } },
    "survivingStrategyIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "crossReview": { "$ref": "#/$defs/crossReview" },
    "selectedStrategyId": { "type": ["string", "null"], "minLength": 1 },
    "nextTaskSeed": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/taskSeed" }] },
    "approvalRequired": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "verdict": { "enum": ["SELECTED", "NEEDS_APPROVAL", "NEEDS_INPUT", "NO_VIABLE_STRATEGY", "BLOCKED"] }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "excluded": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "sourceTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "envelopeDigest"],
      "properties": { "taskId": { "type": "string", "minLength": 1 }, "envelopeDigest": { "$ref": "#/$defs/digest" } }
    },
    "sourceWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "revision", "receiptDigest"],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 },
        "receiptDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reportDigest", "requestArtifactDigest", "confirmedCauseId"],
      "properties": {
        "reportDigest": { "$ref": "#/$defs/digest" },
        "requestArtifactDigest": { "$ref": "#/$defs/digest" },
        "confirmedCauseId": { "type": "string", "minLength": 1 }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategyId", "summary", "mechanism", "actions", "writeTargets", "preconditions", "verificationPlan", "stopConditions", "failureImpact", "reversibility", "causeFit", "verificationStrength", "changeBreadth", "scopeExpansion", "objectivePreserved", "acceptanceCriteriaPreserved", "mutatesPriorRun", "repeatsPriorAttempt", "requiredAuthorization", "evidenceRefs", "strategyFingerprint", "objectiveGate"],
      "properties": {
        "strategyId": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "mechanism": { "type": "string", "minLength": 1 },
        "actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action" } },
        "writeTargets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "preconditions": { "type": "array", "items": { "$ref": "#/$defs/precondition" } },
        "verificationPlan": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/verification" } },
        "stopConditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "failureImpact": { "enum": ["low", "medium", "high", "critical"] },
        "reversibility": { "enum": ["full", "partial", "none"] },
        "causeFit": { "enum": ["direct", "containment", "workaround", "none"] },
        "verificationStrength": { "enum": ["direct", "indirect", "unavailable"] },
        "changeBreadth": { "type": "integer", "minimum": 1 },
        "scopeExpansion": { "type": "boolean" },
        "objectivePreserved": { "type": "boolean" },
        "acceptanceCriteriaPreserved": { "type": "boolean" },
        "mutatesPriorRun": { "type": "boolean" },
        "repeatsPriorAttempt": { "type": "boolean" },
        "requiredAuthorization": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "strategyFingerprint": { "$ref": "#/$defs/digest" },
        "objectiveGate": { "$ref": "#/$defs/gate" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "target": { "type": "string", "minLength": 1 } }
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "status", "evidenceRefs"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "status": { "enum": ["satisfied", "unknown", "failed"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "expectedResult", "evidenceRequired"],
      "properties": {
        "check": { "type": "string", "minLength": 1 },
        "expectedResult": { "type": "string", "minLength": 1 },
        "evidenceRequired": { "type": "string", "minLength": 1 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reasons"],
      "properties": {
        "verdict": { "enum": ["PASS", "REQUIRES_APPROVAL", "FAIL"] },
        "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "crossReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviews", "unresolvedStrategyIds"],
      "properties": {
        "status": { "enum": ["not-required", "completed", "unresolved"] },
        "reviews": { "type": "array", "items": { "$ref": "#/$defs/review" } },
        "unresolvedStrategyIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategyId", "challenge", "response", "evidenceRefs"],
      "properties": {
        "strategyId": { "type": "string", "minLength": 1 },
        "challenge": { "type": "string", "minLength": 1 },
        "response": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "taskSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "recoveryObjective", "scope", "acceptanceCriteria", "constraints", "workUnits", "requiredCapabilities", "requestedActions", "verificationPlan"],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "recoveryObjective": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "workUnits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/workUnit" } },
        "requiredCapabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "requestedActions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "verificationPlan": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/verification" } }
      }
    },
    "workUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "objective", "dependencies", "writeTargets"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "writeTargets": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  }
}
