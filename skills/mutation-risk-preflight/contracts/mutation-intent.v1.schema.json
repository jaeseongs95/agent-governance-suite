{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-governance-skills.dev/mutation-risk-preflight/contracts/mutation-intent.v1.schema.json",
  "title": "MutationIntent.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operationId", "actionClass", "targets", "plannedCommandOrTool", "scopeRef", "authorizationRef", "approvalEvidenceRefs", "currentStateEvidenceRefs", "recoveryPlan", "expectedBlastRadius"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "operationId": { "type": "string", "minLength": 1 },
    "actionClass": { "enum": ["delete", "overwrite", "move", "deploy", "publish", "migrate", "permission-change", "billing", "global-config", "other"] },
    "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target" } },
    "plannedCommandOrTool": { "type": "object", "additionalProperties": false, "required": ["tool", "action"], "properties": { "tool": { "type": "string", "minLength": 1 }, "action": { "type": "string", "minLength": 1 } } },
    "scopeRef": { "$ref": "#/$defs/scope" },
    "authorizationRef": { "$ref": "#/$defs/authorization" },
    "approvalEvidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/approval" } },
    "currentStateEvidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/currentState" } },
    "recoveryPlan": { "$ref": "#/$defs/recovery" },
    "expectedBlastRadius": { "$ref": "#/$defs/blastRadius" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "target": { "type": "object", "additionalProperties": false, "required": ["locator", "targetType", "environment", "expectedFingerprint"], "properties": { "locator": { "type": "string", "minLength": 1 }, "targetType": { "type": "string", "minLength": 1 }, "environment": { "type": "string", "minLength": 1 }, "expectedFingerprint": { "$ref": "#/$defs/digest" } } },
    "scope": { "type": "object", "additionalProperties": false, "required": ["locator", "digest", "includedTargets", "excludedTargets"], "properties": { "locator": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" }, "includedTargets": { "type": "array", "items": { "type": "string" } }, "excludedTargets": { "type": "array", "items": { "type": "string" } } } },
    "authorization": { "type": "object", "additionalProperties": false, "required": ["locator", "digest", "allowedActions", "allowedTargets", "environments"], "properties": { "locator": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" }, "allowedActions": { "type": "array", "items": { "type": "string" } }, "allowedTargets": { "type": "array", "items": { "type": "string" } }, "environments": { "type": "array", "items": { "type": "string" } } } },
    "approval": { "type": "object", "additionalProperties": false, "required": ["locator", "digest", "operationId", "actionClass", "targetLocators", "environments", "expiresAt"], "properties": { "locator": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" }, "operationId": { "type": "string" }, "actionClass": { "type": "string" }, "targetLocators": { "type": "array", "items": { "type": "string" } }, "environments": { "type": "array", "items": { "type": "string" } }, "expiresAt": { "type": "string", "format": "date-time" } } },
    "currentState": { "type": "object", "additionalProperties": false, "required": ["locator", "digest", "targetLocator", "fingerprint"], "properties": { "locator": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" }, "targetLocator": { "type": "string" }, "fingerprint": { "$ref": "#/$defs/digest" } } },
    "recovery": { "type": "object", "additionalProperties": false, "required": ["available", "method", "backupRef", "restoreProcedureRef", "restoreTestEvidenceRef", "irreversibilityAccepted"], "properties": { "available": { "type": "boolean" }, "method": { "type": ["string", "null"] }, "backupRef": { "type": ["string", "null"] }, "restoreProcedureRef": { "type": ["string", "null"] }, "restoreTestEvidenceRef": { "type": ["string", "null"] }, "irreversibilityAccepted": { "type": "boolean" } } },
    "blastRadius": { "type": "object", "additionalProperties": false, "required": ["affectedTargets", "affectedUsers", "external", "description"], "properties": { "affectedTargets": { "type": "integer", "minimum": 1 }, "affectedUsers": { "type": "integer", "minimum": 0 }, "external": { "type": "boolean" }, "description": { "type": "string", "minLength": 1 } } }
  }
}
