{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-governance-skills.dev/mutation-risk-preflight/integration/provider-result.v1.schema.json",
  "title": "ProviderResult.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "output", "artifacts", "error"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "enum": ["output", "adapter-error"] },
    "output": { "type": ["object", "null"] },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "error": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/error" }] }
  },
  "$defs": {
    "artifact": { "type": "object", "additionalProperties": false, "required": ["artifactId", "schemaId", "locator", "digest", "targetDigest", "verified"], "properties": { "artifactId": { "type": "string", "minLength": 1 }, "schemaId": { "type": "string", "minLength": 1 }, "locator": { "type": "string", "minLength": 1 }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "targetDigest": { "type": "string", "minLength": 1 }, "verified": { "type": "boolean" } } },
    "error": { "type": "object", "additionalProperties": false, "required": ["code", "message", "details"], "properties": { "code": { "enum": ["INVALID_INPUT", "RUN_NOT_FOUND", "STALE_REVISION", "INVALID_TRANSITION", "MISSING_EVIDENCE", "GATE_FAILED", "MCP_UNAVAILABLE"] }, "message": { "type": "string", "minLength": 1 }, "details": { "type": ["object", "null"] } } }
  }
}
