{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/workflow-receipt.v1.schema.json",
  "title": "WorkflowReceipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "revision", "state", "plan", "stageResults", "blockers", "unresolved", "error", "unverifiedClaims"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "state": { "enum": ["ready", "running", "needs-input", "needs-approval", "needs-redesign", "failed", "passed", "blocked"] },
    "plan": { "$ref": "https://skill-suite.local/contracts/workflow-plan.v1.schema.json" },
    "stageResults": { "type": "array", "items": { "$ref": "https://skill-suite.local/contracts/stage-result.v1.schema.json" } },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "unresolved": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "error": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/error" }] },
    "unverifiedClaims": {
      "description": "Server-computed. Properties the recorded passes rely on that AGS did not observe; a passed receipt with entries is a record of declarations, not verification.",
      "type": "array",
      "items": { "$ref": "#/$defs/unverifiedClaim" }
    }
  },
  "$defs": {
    "unverifiedClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageId", "claim"],
      "properties": {
        "stageId": { "type": ["string", "null"], "minLength": 1 },
        "claim": { "enum": ["actor-independence", "fresh-context", "no-redelegation", "post-execution-state", "panel-independence", "conditions-verified", "worker-execution-profile", "execution-profile", "evidence-content", "evidence-relevance", "user-approval", "reviewer-independence"] },
        "artifactId": { "type": "string", "minLength": 1 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "details"],
      "properties": {
        "code": { "enum": ["INVALID_INPUT", "RUN_NOT_FOUND", "STALE_REVISION", "INVALID_TRANSITION", "MISSING_EVIDENCE", "GATE_FAILED", "MCP_UNAVAILABLE", "LEASE_REQUIRED", "LEASE_CONFLICT", "FRAME_REVIEW_REQUIRED", "ATTEMPT_BUDGET_EXHAUSTED", "NEW_EVIDENCE_REQUIRED", "ROOT_CONFLICT", "CONTINUITY_UNAVAILABLE", "BINDING_REQUIRED", "BINDING_INVALID", "SNAPSHOT_NOT_FOUND", "SNAPSHOT_CONFLICT", "REQUEST_CONFLICT", "INTEGRITY_FAILED"] },
        "message": { "type": "string", "minLength": 1 },
        "messageKey": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*([.][A-Za-z0-9_-]+)+$" },
        "params": { "type": "object" },
        "details": { "type": ["object", "null"], "additionalProperties": true }
      }
    }
  }
}
