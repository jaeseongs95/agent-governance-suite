  "assignedCase": {
    "caseId": "SS19",
    "title": "JEV OFF에서도 벤더 분류 계속",
    "familyId": "mechanical-SS19",
    "publicSynthetic": true,
    "status": "NOT_RUN",
    "executionKind": "mock 필수. host-live/provider-live는 해당 vendor 경로·비용의 실행 승인을 확인한 뒤 수행한다.",
    "originalPrompt": null,
    "sourceSpec": {
      "path": "TEST-SPEC.seq7.ko.md",
      "section": "SS19",
      "fields": {
        "입력": "SS03·SS04·SS09·SS10을 jevEnabled=false로 실행한다. 현재 사용자 벤더의 중앙 profile·qualification·승인 route와 유효 모델 응답을 제공하고, 외부 전송 허용/차단을 별도 변형으로 둔다. 차단 변형은 사용할 수 있는 native 분류 route도 없는 조건이다.",
        "필수추천": "사전 품질·비용 검토를 통과한 사용자 벤더의 고정 profile 모델로 실제 분류한 B가 golden 목적 정답을 만족해야 한다.",
        "금지추천 또는 행동": "JEV 호출·JEV credential 조회; OFF를 모든 분류 중단으로 해석; 이전 freeform 답을 재사용하고 모델 분류했다고 주장; 외부 전송 차단을 fallback으로 우회.",
        "허용선택": "허용된 vendor 분류 호출과 B의 실제 선택. 추가 유료 API 권한이 없거나 허용 경로가 없으면 이유를 명시하고 보류한다.",
        "보류조건": "profile·qualification·지원 옵션·승인 접근·예산을 확인할 수 없거나 externalClassificationAllowed=false에서 허용 경로가 없음.",
        "통과기준": "jevCallCount=0, 허용 경로에서는 vendorClassifierCallCount가 실제 분류 시도와 일치하고 B도 목적 정답 PASS다. OFF에서 vendor 호출이 발생했다는 이유로 실패 처리하지 않는다. 전역 전송 금지 변형은 두 원격 경로 모두 0이며 성공 분류를 꾸며내지 않는다.",
        "증거": "E0·E1·E3·E4, 선택한 vendor/model·route·가격 근거와 실제 분류 receipt.",
        "실행종류": "mock 필수. host-live/provider-live는 해당 vendor 경로·비용의 실행 승인을 확인한 뒤 수행한다."
      },
      "bodyDigest": "sha256:93c26f47ecd661ca62a45f06cb86c7166d1045a4636009a4c5c29f4a4a7e4e77"
    },
    "oracle": null,
    "variants": [
      "off-allowed",
      "off-egress-denied-no-native"
    ]
  },
