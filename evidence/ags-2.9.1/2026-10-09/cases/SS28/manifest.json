  ],
  "hashPolicy": {
    "manifestExcludes": [
      "manifest.json",
      "SHA256SUMS"
    ],
    "SHA256SUMSExcludes": [
      "SHA256SUMS"
    ],
    "noCircularHash": true,
    "publicationControlDigestsReportedExternally": true
  }
}
