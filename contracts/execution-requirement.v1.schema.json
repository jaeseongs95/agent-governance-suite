{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/execution-requirement.v1.schema.json",
  "title": "ExecutionRequirement.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyId",
    "kind",
    "minimumModelClass",
    "minimumReasoningEffort",
    "observationRequired"
  ],
  "properties": {
    "policyId": {
      "const": "semantic-execution-assurance-v1"
    },
    "kind": {
      "enum": [
        "deterministic",
        "semantic"
      ]
    },
    "minimumModelClass": {
      "description": "Recommended model class recorded with the plan. Advisory only: a lower observed class is recorded, not refused.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "lightweight",
        "general",
        "deep",
        "frontier",
        null
      ]
    },
    "minimumReasoningEffort": {
      "description": "Recommended reasoning effort recorded with the plan. Advisory only: a lower or unobserved effort is recorded, not refused.",
      "type": [
        "string",
        "null"
      ],
      "anyOf": [
        {
          "$ref": "https://skill-suite.local/contracts/model-policy.v1.schema.json#/$defs/reasoningEffort"
        },
        {
          "type": "null"
        }
      ]
    },
    "observationRequired": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "deterministic"
          }
        }
      },
      "then": {
        "properties": {
          "minimumModelClass": {
            "type": "null"
          },
          "minimumReasoningEffort": {
            "type": "null"
          },
          "observationRequired": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "semantic"
          }
        }
      },
      "then": {
        "properties": {
          "minimumModelClass": {
            "enum": [
              "lightweight",
              "general",
              "deep",
              "frontier",
              null
            ]
          },
          "minimumReasoningEffort": {
            "anyOf": [
              {
                "$ref": "https://skill-suite.local/contracts/model-policy.v1.schema.json#/$defs/reasoningEffort"
              },
              {
                "type": "null"
              }
            ]
          },
          "observationRequired": {
            "const": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "minimumModelClass": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "minimumReasoningEffort": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "minimumReasoningEffort": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    }
  ]
}
