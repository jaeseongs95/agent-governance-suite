{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/plugin-update-status.v1.schema.json",
  "title": "PluginUpdateStatus.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pluginId",
    "currentVersion",
    "latestVersion",
    "latestTag",
    "latestCommit",
    "comparison",
    "lastAttemptAt",
    "lastSuccessfulCheckAt",
    "nextCheckAt",
    "stale",
    "lastErrorCode",
    "automaticInstall"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "pluginId": { "const": "agent-governance-suite" },
    "currentVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "latestVersion": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      ]
    },
    "latestTag": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      ]
    },
    "latestCommit": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{40}$" }] },
    "comparison": { "enum": ["unknown", "up-to-date", "update-available", "ahead-of-stable"] },
    "lastAttemptAt": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] },
    "lastSuccessfulCheckAt": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] },
    "nextCheckAt": { "type": "string", "format": "date-time" },
    "stale": { "type": "boolean" },
    "lastErrorCode": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["TIMEOUT", "NETWORK", "HTTP", "INVALID_RESPONSE", "NO_STABLE_TAG"] }
      ]
    },
    "automaticInstall": { "const": false }
  }
}
