{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/host-integration.v1.schema.json",
  "title": "HostIntegration.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "entryPoints"],
  "properties": {
    "format": { "const": "agent-governance-suite.host-integration.v1" },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "entryPoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "executionClosure"],
        "properties": {
          "id": { "enum": ["mcp-server", "host-attestation-cli", "scope-baseline", "scope-compare", "acceptance-cli"] },
          "path": { "type": "string", "minLength": 1 },
          "executionClosure": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
