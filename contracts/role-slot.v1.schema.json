{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/role-slot.v1.schema.json",
  "title": "RoleSlot.v1",
  "description": "Projection of an approved assignment. Structural validity alone is not authorization; compare against the server-owned approved slot set.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "slotId", "authorization", "slotIndex", "slotCount", "purpose", "routingRole", "riskLevel", "highRisk", "independenceRequired", "requirements", "executionAuthorized"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "role-slot-projection" },
    "slotId": { "type": "string", "pattern": "^slot-sha256:[a-f0-9]{64}$" },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["taskId", "runId", "stageId", "assignmentId", "planRevision", "planDigest", "authorizationDigest"],
      "properties": {
        "taskId": { "$ref": "#/$defs/id" },
        "runId": { "$ref": "#/$defs/id" },
        "stageId": { "$ref": "#/$defs/id" },
        "assignmentId": { "$ref": "#/$defs/id" },
        "planRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "planDigest": { "$ref": "#/$defs/digest" },
        "authorizationDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "slotIndex": { "type": "integer", "minimum": 0, "maximum": 63 },
    "slotCount": { "type": "integer", "minimum": 1, "maximum": 64 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "routingRole": { "enum": ["discovery", "general-implementation", "complex-reasoning", "independent-audit"] },
    "riskLevel": { "enum": ["low", "medium", "high", "critical"] },
    "highRisk": { "type": "boolean" },
    "independenceRequired": { "type": "boolean" },
    "requirements": { "$ref": "https://skill-suite.local/contracts/model-selection-request.v2.schema.json#/$defs/requirements" },
    "executionAuthorized": { "const": false }
  },
  "allOf": [
    {
      "if": { "anyOf": [
        { "properties": { "riskLevel": { "enum": ["high", "critical"] } }, "required": ["riskLevel"] },
        { "properties": { "routingRole": { "const": "independent-audit" } }, "required": ["routingRole"] }
      ] },
      "then": { "properties": { "highRisk": { "const": true } } },
      "else": { "properties": { "highRisk": { "const": false } } }
    },
    {
      "if": { "properties": { "routingRole": { "const": "independent-audit" } }, "required": ["routingRole"] },
      "then": {
        "properties": {
          "highRisk": { "const": true },
          "independenceRequired": { "const": true },
          "requirements": { "properties": { "contextMode": { "const": "limited" } } }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
