{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/workflow-plan.v1.schema.json",
  "title": "WorkflowPlan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "integrityToken",
    "executionMode",
    "state",
    "selectedSkills",
    "stages",
    "currentStageId",
    "nextStageId",
    "errors"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "taskDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "integrityToken": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "executionMode": {
      "enum": [
        "direct",
        "orchestrated"
      ]
    },
    "state": {
      "enum": [
        "ready",
        "running",
        "needs-input",
        "needs-approval",
        "needs-redesign",
        "failed",
        "passed",
        "blocked"
      ]
    },
    "selectedSkills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "currentStageId": {
      "type": [
        "string",
        "null"
      ]
    },
    "nextStageId": {
      "type": [
        "string",
        "null"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "bootstrapExecution": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirement",
            "context"
          ],
          "properties": {
            "requirement": {
              "$ref": "#/$defs/executionRequirement"
            },
            "context": {
              "$ref": "#/$defs/executionContext"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stageId",
        "order",
        "requiredCapability",
        "satisfiedCapabilities",
        "skillId",
        "phase",
        "selectionReason",
        "state",
        "requiredArtifacts",
        "riskGate",
        "providerKey",
        "executionClass",
        "phaseOrder",
        "requiredInputArtifacts",
        "inputBindings",
        "producedArtifacts",
        "outputSchema",
        "resultSchema",
        "stateMapping",
        "gate"
      ],
      "properties": {
        "stageId": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "requiredCapability": {
          "type": "string",
          "minLength": 1
        },
        "evaluationAuditPurpose": {
          "enum": [
            "design-readiness",
            "quality-or-release"
          ]
        },
        "satisfiedCapabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "skillId": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "selectionReason": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "ready",
            "running",
            "needs-input",
            "needs-approval",
            "needs-redesign",
            "failed",
            "passed",
            "blocked"
          ]
        },
        "requiredArtifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "riskGate": {
          "enum": [
            "none",
            "conditional",
            "mandatory"
          ]
        },
        "providerKey": {
          "type": "string",
          "minLength": 1
        },
        "executionClass": {
          "enum": [
            "workflow",
            "recovery"
          ]
        },
        "phaseOrder": {
          "type": "integer",
          "minimum": 0
        },
        "requiredInputArtifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "inputBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputBinding"
          }
        },
        "producedArtifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "outputSchema": {
          "$ref": "#/$defs/schemaReference"
        },
        "resultSchema": {
          "$ref": "#/$defs/schemaReference"
        },
        "stateMapping": {
          "$ref": "#/$defs/stateMapping"
        },
        "gate": {
          "$ref": "#/$defs/gate"
        },
        "receiptPolicy": {
          "$ref": "#/$defs/receiptPolicy"
        },
        "executionRequirement": {
          "$ref": "#/$defs/executionRequirement"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "requiredCapability": {
                "const": "evaluation-validity-audit"
              }
            }
          },
          "then": {
            "properties": {
              "evaluationAuditPurpose": {
                "enum": [
                  "design-readiness",
                  "quality-or-release"
                ]
              }
            },
            "required": [
              "evaluationAuditPurpose"
            ]
          }
        }
      ]
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetArtifact",
        "sources",
        "operation"
      ],
      "properties": {
        "targetArtifact": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "operation": {
          "enum": [
            "select",
            "collect",
            "combine",
            "require-external"
          ]
        },
        "optional": {
          "type": "boolean"
        }
      }
    },
    "schemaReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "mappingRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "errorRequired"
      ],
      "properties": {
        "state": {
          "enum": [
            "needs-input",
            "needs-approval",
            "needs-redesign",
            "failed",
            "passed",
            "blocked"
          ]
        },
        "errorRequired": {
          "type": "boolean"
        },
        "allowedErrorCodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/errorCode"
          },
          "uniqueItems": true
        }
      }
    },
    "stateMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "adapterErrors"
      ],
      "properties": {
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/mappingRule"
          }
        },
        "default": {
          "oneOf": [
            {
              "const": "reject"
            },
            {
              "$ref": "#/$defs/mappingRule"
            }
          ]
        },
        "adapterErrors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/errorCode"
          },
          "uniqueItems": true
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "policy"
      ],
      "properties": {
        "kind": {
          "enum": [
            "none",
            "precondition",
            "completion"
          ]
        },
        "policy": {
          "enum": [
            "none",
            "conditional",
            "mandatory"
          ]
        },
        "validator": {
          "type": [
            "string",
            "null"
          ]
        },
        "validatorSchema": {
          "oneOf": [
            {
              "$ref": "#/$defs/schemaReference"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "receiptPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "const": "reference-only"
        },
        "actorIdPointer": {
          "type": "string",
          "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$"
        },
        "uniqueness": {
          "const": "run"
        },
        "actorIdsPointer": {
          "type": "string",
          "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$"
        },
        "actorIdsMatch": {
          "const": "prior-policy-actors"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "uniqueness"
            ]
          },
          "then": {
            "required": [
              "actorIdPointer"
            ]
          }
        },
        {
          "if": {
            "required": [
              "actorIdsPointer"
            ]
          },
          "then": {
            "required": [
              "actorIdsMatch"
            ]
          }
        },
        {
          "if": {
            "required": [
              "actorIdsMatch"
            ]
          },
          "then": {
            "required": [
              "actorIdsPointer"
            ]
          }
        }
      ]
    },
    "errorCode": {
      "enum": [
        "INVALID_INPUT",
        "RUN_NOT_FOUND",
        "STALE_REVISION",
        "INVALID_TRANSITION",
        "MISSING_EVIDENCE",
        "GATE_FAILED",
        "MCP_UNAVAILABLE",
        "LEASE_REQUIRED",
        "LEASE_CONFLICT",
        "FRAME_REVIEW_REQUIRED",
        "ATTEMPT_BUDGET_EXHAUSTED",
        "NEW_EVIDENCE_REQUIRED",
        "ROOT_CONFLICT",
        "CONTINUITY_UNAVAILABLE",
        "BINDING_REQUIRED",
        "BINDING_INVALID",
        "SNAPSHOT_NOT_FOUND",
        "SNAPSHOT_CONFLICT",
        "REQUEST_CONFLICT",
        "INTEGRITY_FAILED"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "details"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/errorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      }
    },
    "executionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "model",
        "modelClass",
        "reasoningEffort",
        "source",
        "observedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "modelClass": {
          "enum": [
            "lightweight",
            "general",
            "deep",
            "frontier"
          ]
        },
        "reasoningEffort": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        },
        "source": {
          "enum": [
            "runtime",
            "spawn-result"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "observationId": {
          "type": "string",
          "minLength": 16
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "stageId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "actorId": {
          "type": "string",
          "minLength": 1
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "executionRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "kind",
        "minimumModelClass",
        "minimumReasoningEffort",
        "observationRequired"
      ],
      "properties": {
        "policyId": {
          "const": "semantic-execution-assurance-v1"
        },
        "kind": {
          "enum": [
            "deterministic",
            "semantic"
          ]
        },
        "minimumModelClass": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "lightweight",
            "general",
            "deep",
            "frontier",
            null
          ]
        },
        "minimumReasoningEffort": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra",
            null
          ]
        },
        "observationRequired": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "deterministic"
              }
            }
          },
          "then": {
            "properties": {
              "minimumModelClass": {
                "type": "null"
              },
              "minimumReasoningEffort": {
                "type": "null"
              },
              "observationRequired": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "semantic"
              }
            }
          },
          "then": {
            "properties": {
              "minimumModelClass": {
                "enum": [
                  "lightweight",
                  "general",
                  "deep",
                  "frontier"
                ]
              },
              "minimumReasoningEffort": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max",
                  "ultra"
                ]
              },
              "observationRequired": {
                "const": true
              }
            }
          }
        }
      ]
    }
  }
}
