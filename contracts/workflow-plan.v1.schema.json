{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/workflow-plan.v1.schema.json",
  "title": "WorkflowPlan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "integrityToken", "executionMode", "state", "selectedSkills", "stages", "currentStageId", "nextStageId", "errors"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "taskId": { "type": "string", "minLength": 1 },
    "taskDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "integrityToken": { "type": "string", "minLength": 1 },
    "executionMode": { "enum": ["direct", "orchestrated"] },
    "state": { "enum": ["ready", "running", "needs-input", "needs-approval", "needs-redesign", "failed", "passed", "blocked"] },
    "selectedSkills": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "stages": { "type": "array", "items": { "$ref": "#/$defs/stage" } },
    "currentStageId": { "type": ["string", "null"] },
    "nextStageId": { "type": ["string", "null"] },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageId", "order", "requiredCapability", "satisfiedCapabilities", "skillId", "phase", "selectionReason", "state", "requiredArtifacts", "riskGate", "providerKey", "executionClass", "phaseOrder", "requiredInputArtifacts", "inputBindings", "producedArtifacts", "outputSchema", "resultSchema", "stateMapping", "gate"],
      "properties": {
        "stageId": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "requiredCapability": { "type": "string", "minLength": 1 },
        "satisfiedCapabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "skillId": { "type": "string", "minLength": 1 },
        "phase": { "type": "string", "minLength": 1 },
        "selectionReason": { "type": "string", "minLength": 1 },
        "state": { "enum": ["ready", "running", "needs-input", "needs-approval", "needs-redesign", "failed", "passed", "blocked"] },
        "requiredArtifacts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "riskGate": { "enum": ["none", "conditional", "mandatory"] },
        "providerKey": { "type": "string", "minLength": 1 },
        "executionClass": { "enum": ["workflow", "recovery"] },
        "phaseOrder": { "type": "integer", "minimum": 0 },
        "requiredInputArtifacts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "inputBindings": { "type": "array", "items": { "$ref": "#/$defs/inputBinding" } },
        "producedArtifacts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "outputSchema": { "$ref": "#/$defs/schemaReference" },
        "resultSchema": { "$ref": "#/$defs/schemaReference" },
        "stateMapping": { "$ref": "#/$defs/stateMapping" },
        "gate": { "$ref": "#/$defs/gate" },
        "receiptPolicy": { "$ref": "#/$defs/receiptPolicy" }
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetArtifact", "sources", "operation"],
      "properties": {
        "targetArtifact": { "type": "string", "minLength": 1 },
        "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "operation": { "enum": ["select", "collect", "combine", "require-external"] },
        "optional": { "type": "boolean" }
      }
    },
    "schemaReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "mappingRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "errorRequired"],
      "properties": {
        "state": { "enum": ["needs-input", "needs-approval", "needs-redesign", "failed", "passed", "blocked"] },
        "errorRequired": { "type": "boolean" },
        "allowedErrorCodes": { "type": "array", "items": { "$ref": "#/$defs/errorCode" }, "uniqueItems": true }
      }
    },
    "stateMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "adapterErrors"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "values": { "type": "object", "additionalProperties": { "$ref": "#/$defs/mappingRule" } },
        "default": { "oneOf": [{ "const": "reject" }, { "$ref": "#/$defs/mappingRule" }] },
        "adapterErrors": { "type": "array", "items": { "$ref": "#/$defs/errorCode" }, "uniqueItems": true }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "policy"],
      "properties": {
        "kind": { "enum": ["none", "precondition", "completion"] },
        "policy": { "enum": ["none", "conditional", "mandatory"] },
        "validator": { "type": ["string", "null"] },
        "validatorSchema": { "oneOf": [{ "$ref": "#/$defs/schemaReference" }, { "type": "null" }] }
      }
    },
    "receiptPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "const": "reference-only" },
        "actorIdPointer": { "type": "string", "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$" },
        "uniqueness": { "const": "run" },
        "actorIdsPointer": { "type": "string", "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$" },
        "actorIdsMatch": { "const": "prior-policy-actors" }
      },
      "allOf": [
        {
          "if": { "required": ["uniqueness"] },
          "then": { "required": ["actorIdPointer"] }
        },
        {
          "if": { "required": ["actorIdsPointer"] },
          "then": { "required": ["actorIdsMatch"] }
        },
        {
          "if": { "required": ["actorIdsMatch"] },
          "then": { "required": ["actorIdsPointer"] }
        }
      ]
    },
    "errorCode": { "enum": ["INVALID_INPUT", "RUN_NOT_FOUND", "STALE_REVISION", "INVALID_TRANSITION", "MISSING_EVIDENCE", "GATE_FAILED", "MCP_UNAVAILABLE", "LEASE_REQUIRED", "LEASE_CONFLICT", "FRAME_REVIEW_REQUIRED", "ATTEMPT_BUDGET_EXHAUSTED", "NEW_EVIDENCE_REQUIRED", "ROOT_CONFLICT"] },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "details"],
      "properties": {
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": ["object", "null"], "additionalProperties": true }
      }
    }
  }
}
