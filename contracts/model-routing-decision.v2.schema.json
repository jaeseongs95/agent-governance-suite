{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/model-routing-decision.v2.schema.json",
  "title": "model-routing-decision.v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "catalogDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "policyDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "capabilitySetDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "capabilitySnapshotDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested": {
      "anyOf": [
        {
          "$ref": "#/$defs/preference"
        },
        {
          "type": "null"
        }
      ]
    },
    "selected": {
      "anyOf": [
        {
          "$ref": "#/$defs/selection"
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/target"
        },
        {
          "type": "null"
        }
      ]
    },
    "invocationSurface": {
      "anyOf": [
        {
          "enum": [
            "local-subagent",
            "peer-session",
            "headless"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "selected",
        "blocked"
      ]
    },
    "executionAuthorized": {
      "const": false
    },
    "trustedGateSatisfied": {
      "const": false
    },
    "selectionReasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$"
      },
      "maxItems": 128,
      "uniqueItems": true
    },
    "rejectedCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidateKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "reasonCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$"
            },
            "maxItems": 128,
            "uniqueItems": true
          }
        },
        "required": [
          "candidateKey",
          "reasonCodes"
        ]
      },
      "maxItems": 65536,
      "uniqueItems": true
    },
    "fallbackReason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "decisionDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "binding",
    "requestDigest",
    "catalogDigest",
    "policyDigest",
    "capabilitySetDigest",
    "capabilitySnapshotDigest",
    "requested",
    "selected",
    "target",
    "invocationSurface",
    "status",
    "executionAuthorized",
    "trustedGateSatisfied",
    "selectionReasonCodes",
    "rejectedCandidates",
    "fallbackReason",
    "decisionDigest"
  ],
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assignmentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$"
        },
        "stageId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "candidateDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "assignmentId",
        "taskId",
        "runId",
        "stageId",
        "attemptId",
        "revision",
        "inputDigest",
        "candidateDigest"
      ]
    },
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strength": {
          "enum": [
            "required",
            "preferred"
          ]
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$"
        },
        "host": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$"
        },
        "nativeReasoning": {
          "$ref": "#/$defs/reasoning"
        },
        "runtimeMode": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$"
        }
      },
      "required": [
        "strength"
      ],
      "minProperties": 2
    },
    "reasoning": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "enum"
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$",
              "not": {
                "enum": [
                  "ultra",
                  "ultracode"
                ]
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "token-budget"
            },
            "budgetTokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            }
          },
          "required": [
            "kind",
            "budgetTokens"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "toggle"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "enabled"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "not-exposed"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$"
        },
        "resolvedModel": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$"
        },
        "modelOrigin": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$"
        },
        "servingProvider": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$"
        },
        "accessPath": {
          "enum": [
            "subscription",
            "api",
            "enterprise",
            "unknown"
          ]
        },
        "nativeReasoning": {
          "$ref": "#/$defs/reasoning"
        },
        "runtimeMode": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$"
        }
      },
      "required": [
        "model",
        "resolvedModel",
        "modelOrigin",
        "servingProvider",
        "accessPath",
        "nativeReasoning",
        "runtimeMode"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$"
        },
        "host": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$"
        },
        "instanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$"
        }
      },
      "required": [
        "actorId",
        "host",
        "sessionId",
        "instanceId"
      ]
    }
  }
}
