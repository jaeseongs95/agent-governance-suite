{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/convergence-status-summary.v1.schema.json",
  "title": "ConvergenceStatusSummary.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "root", "currentEpoch", "maxAttemptsPerEpoch", "maxEpochs", "attemptsUsedInEpoch", "attemptsRemainingInEpoch", "issuedLeaseId", "latestWorkflowRunId", "latestOutcomeId", "latestOutcomeState", "latestOutcomeReceiptDigest", "proposalCount", "leaseCount", "outcomeCount", "reviewCount", "gateErrorCode"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "root": { "$ref": "https://skill-suite.local/contracts/convergence-root-handle.v1.schema.json" },
    "currentEpoch": { "type": "integer", "minimum": 1, "maximum": 2 },
    "maxAttemptsPerEpoch": { "const": 3 },
    "maxEpochs": { "const": 2 },
    "attemptsUsedInEpoch": { "type": "integer", "minimum": 0, "maximum": 3 },
    "attemptsRemainingInEpoch": { "type": "integer", "minimum": 0, "maximum": 3 },
    "issuedLeaseId": { "type": ["string", "null"] },
    "latestWorkflowRunId": { "type": ["string", "null"] },
    "latestOutcomeId": { "type": ["string", "null"] },
    "latestOutcomeState": { "oneOf": [{ "type": "null" }, { "enum": ["passed", "failed", "aborted"] }] },
    "latestOutcomeReceiptDigest": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      ]
    },
    "proposalCount": { "type": "integer", "minimum": 0 },
    "leaseCount": { "type": "integer", "minimum": 0 },
    "outcomeCount": { "type": "integer", "minimum": 0 },
    "reviewCount": { "type": "integer", "minimum": 0 },
    "gateErrorCode": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["INVALID_INPUT", "RUN_NOT_FOUND", "STALE_REVISION", "INVALID_TRANSITION", "MISSING_EVIDENCE", "GATE_FAILED", "MCP_UNAVAILABLE", "LEASE_REQUIRED", "LEASE_CONFLICT", "FRAME_REVIEW_REQUIRED", "ATTEMPT_BUDGET_EXHAUSTED", "NEW_EVIDENCE_REQUIRED", "ROOT_CONFLICT", "CONTINUITY_UNAVAILABLE", "BINDING_REQUIRED", "BINDING_INVALID", "SNAPSHOT_NOT_FOUND", "SNAPSHOT_CONFLICT", "REQUEST_CONFLICT", "INTEGRITY_FAILED"] }
      ]
    }
  }
}
