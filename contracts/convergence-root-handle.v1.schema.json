{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/convergence-root-handle.v1.schema.json",
  "title": "ConvergenceRootHandle.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rootId", "revision", "state", "currentEpoch", "taskDigest", "frameDigest", "workspaceDigest", "controlDigest", "targetDigest", "operationalDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "rootId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "state": { "enum": ["open", "needs-review", "needs-user", "completed", "abandoned"] },
    "currentEpoch": { "type": "integer", "minimum": 1, "maximum": 2 },
    "taskDigest": { "$ref": "#/$defs/digest" },
    "frameDigest": { "$ref": "#/$defs/digest" },
    "workspaceDigest": { "$ref": "#/$defs/digest" },
    "controlDigest": { "$ref": "#/$defs/digest" },
    "targetDigest": { "$ref": "#/$defs/digest" },
    "operationalDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
