{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/approved-role-source.v1.schema.json",
  "title": "ApprovedRoleSourceSnapshot.v1",
  "description": "Current approved role source read through the common port. A valid instance is a server-owned read, never caller input, and it grants neither execution nor effect start. Reservation and effect start use the separate $defs contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "producer", "scope", "approval", "currentness", "revocation", "slots", "inputProvenance", "grants"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "approved-role-source-snapshot" },
    "producer": { "$ref": "#/$defs/producer" },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["taskId", "runId"],
      "properties": {
        "projectId": { "$ref": "#/$defs/id" },
        "taskId": { "$ref": "#/$defs/id" },
        "runId": { "$ref": "#/$defs/id" }
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "approvalId", "approvalRevision", "approvalDigest"],
      "properties": {
        "origin": { "enum": ["ags-workflow-approval-record", "vm-core-goal-authorization"] },
        "approvalId": { "$ref": "#/$defs/id" },
        "approvalRevision": { "$ref": "#/$defs/revision" },
        "approvalDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "currentness": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "sourceRevision", "snapshotId", "snapshotDigest"],
      "properties": {
        "state": { "const": "current" },
        "sourceRevision": { "$ref": "#/$defs/revision" },
        "snapshotId": { "$ref": "#/$defs/id" },
        "snapshotDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "revocation": {
      "type": "object", "additionalProperties": false,
      "required": ["state"],
      "properties": { "state": { "const": "not-revoked" } }
    },
    "slots": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["slotId", "stageId", "assignmentId"],
        "properties": {
          "slotId": { "type": "string", "pattern": "^slot-sha256:[a-f0-9]{64}$" },
          "stageId": { "$ref": "#/$defs/id" },
          "assignmentId": { "$ref": "#/$defs/id" }
        }
      }
    },
    "inputProvenance": { "const": "server-owned-current-read" },
    "grants": {
      "type": "object", "additionalProperties": false,
      "required": ["executionAuthorized", "effectAuthorized"],
      "properties": {
        "executionAuthorized": { "const": false },
        "effectAuthorized": { "const": false }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "producer": { "properties": { "owner": { "const": "ags-workflow" } }, "required": ["owner"] } }, "required": ["producer"] },
      "then": { "properties": { "approval": { "properties": { "origin": { "const": "ags-workflow-approval-record" } } } } },
      "else": { "properties": { "approval": { "properties": { "origin": { "const": "vm-core-goal-authorization" } } } } }
    },
    {
      "if": { "properties": { "producer": { "properties": { "owner": { "const": "flowmarshal-engine" } }, "required": ["owner"] } }, "required": ["producer"] },
      "then": { "properties": { "scope": { "required": ["projectId"] } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,199}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "producer": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["owner", "producerTask", "verification", "principal"],
          "properties": {
            "owner": { "const": "ags-workflow" },
            "producerTask": { "const": "R18" },
            "verification": { "const": "ags-server-store-same-transaction-read" },
            "principal": { "$ref": "#/$defs/principalClaim" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["owner", "producerTask", "verification", "principal"],
          "properties": {
            "owner": { "const": "flowmarshal-engine" },
            "producerTask": { "const": "R16-b" },
            "verification": { "const": "vm-signed-control-one-use-registry" },
            "principal": {
              "allOf": [
                { "$ref": "#/$defs/principalClaim" },
                { "properties": { "profileId": { "const": "vm-protected-v1" } } }
              ]
            }
          }
        }
      ]
    },
    "principalClaim": {
      "description": "Who stands behind the approval. A2 same-user signatures stay same-user claims and never become protected principal evidence.",
      "type": "object", "additionalProperties": false,
      "required": ["profileId", "protectedPrincipal"],
      "properties": {
        "profileId": { "enum": ["ags-local-server", "vm-protected-v1", "flowmarshal-same-user-v1"] },
        "protectedPrincipal": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "profileId": { "enum": ["flowmarshal-same-user-v1", "ags-local-server"] } }, "required": ["profileId"] },
          "then": { "properties": { "protectedPrincipal": { "const": false } } }
        }
      ]
    },
    "reservation": {
      "description": "Claim bound to one current snapshot before any effect. Pending claims carry no session identity; unknown is terminal until reconciliation and never becomes success or cancellation.",
      "type": "object", "additionalProperties": false,
      "required": ["reservationId", "snapshotDigest", "sourceRevision", "state", "identity"],
      "properties": {
        "reservationId": { "$ref": "#/$defs/id" },
        "snapshotDigest": { "$ref": "#/$defs/digest" },
        "sourceRevision": { "$ref": "#/$defs/revision" },
        "state": { "enum": ["pending", "bound", "admitted", "closed", "unknown"] },
        "identity": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["actorId", "host", "sessionId", "verifiedBy"],
              "properties": {
                "actorId": { "$ref": "#/$defs/id" },
                "host": { "$ref": "#/$defs/id" },
                "sessionId": { "$ref": "#/$defs/id" },
                "verifiedBy": { "enum": ["ags-server-session-binding", "vm-trusted-create-thread-receipt"] }
              }
            }
          ]
        },
        "closeReason": { "enum": ["effect-finished", "revoked-before-effect", "stale-before-effect", "reconciled-unknown"] }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "pending" } }, "required": ["state"] },
          "then": { "properties": { "identity": { "type": "null" } }, "not": { "required": ["closeReason"] } }
        },
        {
          "if": { "properties": { "state": { "enum": ["bound", "admitted"] } }, "required": ["state"] },
          "then": { "properties": { "identity": { "type": "object" } }, "not": { "required": ["closeReason"] } }
        },
        {
          "if": { "properties": { "state": { "const": "closed" } }, "required": ["state"] },
          "then": { "required": ["closeReason"] }
        },
        {
          "if": { "properties": { "state": { "const": "unknown" } }, "required": ["state"] },
          "then": { "not": { "required": ["closeReason"] } }
        }
      ]
    },
    "reservationTransitions": {
      "description": "The only allowed monotonic transitions. Anything else is rejected.",
      "const": {
        "pending": ["bound", "closed", "unknown"],
        "bound": ["admitted", "closed", "unknown"],
        "admitted": ["closed", "unknown"],
        "unknown": ["closed"],
        "closed": []
      }
    },
    "effectStartDecision": {
      "description": "Result of the effect-start port. start requires an admitted reservation whose snapshot is still current and unrevoked when rechecked in the same write transaction as the effect intent.",
      "type": "object", "additionalProperties": false,
      "required": ["decision", "reservationId", "recheckedSourceRevision", "invokeCount"],
      "properties": {
        "decision": { "enum": ["start", "deny", "unknown"] },
        "reservationId": { "$ref": "#/$defs/id" },
        "recheckedSourceRevision": { "$ref": "#/$defs/revision" },
        "invokeCount": { "type": "integer", "minimum": 0, "maximum": 1 },
        "denyReason": { "enum": ["caller-supplied-source", "unknown-slot", "stale-revision", "revoked", "reservation-not-admitted", "identity-unverified", "same-user-not-protected", "source-unqualified"] }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "deny" } }, "required": ["decision"] },
          "then": { "required": ["denyReason"], "properties": { "invokeCount": { "const": 0 } } },
          "else": { "not": { "required": ["denyReason"] } }
        }
      ]
    },
    "correspondenceRow": {
      "type": "object", "additionalProperties": false,
      "required": ["rowId", "source", "tasks", "qualification", "implementationState", "statesProvided", "reservationGuarantee", "unknownGuarantee", "enforcementPoints", "usableAs", "runtimeQualification"],
      "properties": {
        "rowId": { "$ref": "#/$defs/id" },
        "source": { "enum": ["ags", "vm"] },
        "tasks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "qualification": { "enum": ["QUALIFIED", "UNQUALIFIED_PENDING"] },
        "integration": {
          "type": "object", "additionalProperties": false,
          "required": ["repository", "ref", "sha"],
          "properties": {
            "repository": { "enum": ["AGS", "FM"] },
            "ref": { "enum": ["codex/v260-semantic-decision-layer", "main"] },
            "sha": { "$ref": "#/$defs/sha" }
          }
        },
        "implementationState": { "enum": ["NOT_IMPLEMENTED", "IMPLEMENTED_INTEGRATED", "BLOCKED", "NOT_STARTED"] },
        "statesProvided": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "reservationGuarantee": { "type": "string", "minLength": 1 },
        "unknownGuarantee": { "type": "string", "minLength": 1 },
        "enforcementPoints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "usableAs": { "type": "array", "uniqueItems": true, "items": { "const": "contract-freeze-input" } },
        "runtimeQualification": { "const": "NOT_CLAIMED" }
      },
      "allOf": [
        {
          "if": { "properties": { "qualification": { "const": "UNQUALIFIED_PENDING" } }, "required": ["qualification"] },
          "then": { "properties": { "usableAs": { "maxItems": 0 }, "implementationState": { "enum": ["BLOCKED", "NOT_STARTED"] } } }
        },
        {
          "if": { "properties": { "qualification": { "const": "QUALIFIED" }, "source": { "const": "vm" } }, "required": ["qualification", "source"] },
          "then": { "required": ["integration"], "properties": { "implementationState": { "const": "IMPLEMENTED_INTEGRATED" } } }
        },
        {
          "if": { "properties": { "qualification": { "const": "QUALIFIED" }, "source": { "const": "ags" } }, "required": ["qualification", "source"] },
          "then": { "properties": { "implementationState": { "const": "NOT_IMPLEMENTED" } }, "not": { "required": ["integration"] } }
        }
      ]
    },
    "contractFreeze": {
      "type": "object", "additionalProperties": false,
      "required": ["task", "verdict", "progressRequest", "rows", "agsCoreIndependentOfVmRuntime"],
      "properties": {
        "task": { "const": "R17" },
        "verdict": { "enum": ["APPROVED_ROLE_SOURCE_PORT_FROZEN", "CONTRACT_FAILED", "NOT_RUN"] },
        "progressRequest": { "enum": ["COMPLETED", "BLOCKED", "NOT_RUN"] },
        "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/correspondenceRow" } },
        "agsCoreIndependentOfVmRuntime": { "const": true }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "APPROVED_ROLE_SOURCE_PORT_FROZEN" } }, "required": ["verdict"] },
          "then": { "properties": { "progressRequest": { "const": "COMPLETED" } } },
          "else": { "properties": { "progressRequest": { "enum": ["BLOCKED", "NOT_RUN"] } } }
        }
      ]
    }
  }
}
